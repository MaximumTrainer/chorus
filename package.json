{
  "name": "chorus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --project unit --project integration --project contract",
    "test:acceptance": "vitest run --passWithNoTests --project acceptance",
    "test:nfr": "vitest run --project nfr",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:nfr"
  },
  "devDependencies": {
    "@chorus/testing": "workspace:*",
    "@eslint/js": "9.13.0",
    "@types/node": "22.7.5",
    "eslint": "9.13.0",
    "turbo": "2.2.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vitest": "2.1.3",
    "yaml": "2.6.0"
  }
}
