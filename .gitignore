# The website is built from source by .github/workflows/pages.yml. A committed
# build drifts from its sources the first time someone edits one and not the
# other; the recorded JSON in website/src is committed because regenerating it
# needs a database.
website/dist/
website/capture/raw/

# Browser journeys. The harness writes its addresses and seeded ids here for
# the specs to read; traces are kept only for a failure, and only locally.
test/e2e/.harness.json
test-results/
playwright-report/
