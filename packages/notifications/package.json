{
  "name": "@chorus/notifications",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Notification dispatch (SLACK-6). Knows recipients, kinds, preferences and channels — and nothing about what raised the event.",
  "exports": {
    ".": {
      "chorus-dist": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@chorus/core": "workspace:*",
    "@chorus/db": "workspace:*"
  },
  "devDependencies": {
    "@chorus/config": "workspace:*",
    "@chorus/testing": "workspace:*",
    "@types/node": "22.7.5",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
