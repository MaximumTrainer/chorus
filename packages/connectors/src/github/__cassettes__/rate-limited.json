{
  "description": "GitHub refusing with a rate limit, carrying its own reset time.",
  "interactions": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.github.com/repos/acme/widgets/commits?per_page=30&page=1"
      },
      "response": {
        "status": 403,
        "headers": {
          "x-ratelimit-remaining": "0",
          "x-ratelimit-reset": "1790000000",
          "retry-after": "60"
        },
        "body": {
          "message": "API rate limit exceeded",
          "documentation_url": "https://docs.github.com/rest/overview/rate-limits-for-the-rest-api"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.github.com/installation/repositories?per_page=1"
      },
      "response": {
        "status": 200,
        "body": {
          "total_count": 1,
          "repositories": [
            {
              "id": 900,
              "full_name": "acme/widgets",
              "private": true
            }
          ]
        }
      }
    }
  ]
}
