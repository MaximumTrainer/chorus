{
  "name": "@chorus/coding",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Coding-agent execution (architecture.md §12). The one brief builder (CODE-2): a sandbox job and a local agent over MCP receive byte-identical context, or the CLI is a second-class citizen.",
  "exports": {
    ".": {
      "chorus-dist": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@chorus/core": "workspace:*",
    "@chorus/db": "workspace:*",
    "@chorus/llm": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@chorus/config": "workspace:*",
    "@chorus/testing": "workspace:*",
    "@types/node": "22.7.5",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
